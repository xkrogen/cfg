{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.codex/herdr-agent-state.sh\" session",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.local/lib/mbox/current/dist/src/cli.js\" codex hooks event --config \"$HOME/.config/mbox/profiles/personal/hooks/codex-machine.json\"",
            "timeout": 2,
            "statusMessage": "Personal mailbox hook"
          }
        ]
      }
    ]
  }
}