{
  "herdr": {
    "PreInvocation": [
      {
        "command": "bash \"$HOME/.gemini/config/hooks/herdr-agent-state.sh\" session",
        "timeout": 10,
        "type": "command"
      },
      {
        "command": "python3 \"$HOME/.local/bin/named-session.py\" agy hook",
        "timeout": 10,
        "type": "command"
      }
    ],
    "Stop": [
      {
        "command": "python3 \"$HOME/.local/bin/named-session.py\" agy hook",
        "timeout": 10,
        "type": "command"
      }
    ]
  },
  "usps": {
    "SessionStart": [
      {
        "type": "command",
        "command": "/Users/xkrogen/.volta/bin/node /Users/xkrogen/.local/lib/usps/current/dist/src/cli.js --profile personal agy hooks event --event SessionStart --config '/Users/xkrogen/.config/usps/profiles/personal/hooks/agy-krogbook-personal.json'",
        "timeout": 2
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "/Users/xkrogen/.volta/bin/node /Users/xkrogen/.local/lib/usps/current/dist/src/cli.js --profile personal agy hooks event --event PreInvocation --config '/Users/xkrogen/.config/usps/profiles/personal/hooks/agy-krogbook-personal.json'",
        "timeout": 2
      }
    ]
  }
}