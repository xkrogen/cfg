#!/usr/bin/env python3
"""agent-nudge: Monitor a coding agent session in Herdr and wake it up when credits reset.

Usage:
    agent-nudge <target> [options]

Examples:
    agent-nudge usps-setup
    agent-nudge usps-setup --check-once
    agent-nudge usps-setup --message "Credits restored! Please continue."
    agent-nudge --list
"""

import argparse
import datetime
import json
import os
import re
import shutil
import subprocess
import sys
import time
from typing import Any, Dict, List, Optional, Tuple


def get_herdr_bin() -> str:
    """Resolve path to the herdr executable."""
    env_bin = os.environ.get("HERDR_BIN_PATH")
    if env_bin and os.path.isfile(env_bin) and os.access(env_bin, os.X_OK):
        return env_bin
    local_bin = os.path.expanduser("~/.local/bin/herdr")
    if os.path.isfile(local_bin) and os.access(local_bin, os.X_OK):
        return local_bin
    which_bin = shutil.which("herdr")
    if which_bin:
        return which_bin
    return "herdr"


def run_herdr(*args: str) -> Dict[str, Any]:
    """Execute a herdr command and parse its JSON output."""
    binary = get_herdr_bin()
    cmd = [binary, *args]
    try:
        proc = subprocess.run(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=10,
            check=False,
        )
    except FileNotFoundError:
        print(f"Error: herdr binary not found at '{binary}'.", file=sys.stderr)
        sys.exit(1)
    except subprocess.TimeoutExpired:
        print(f"Error: command '{' '.join(cmd)}' timed out.", file=sys.stderr)
        sys.exit(1)

    if proc.returncode != 0:
        err_msg = proc.stderr.strip() or proc.stdout.strip()
        try:
            err_json = json.loads(err_msg)
            return err_json
        except Exception:
            return {"error": {"message": err_msg, "code": proc.returncode}}

    out = proc.stdout.strip()
    if not out:
        return {}
    try:
        return json.loads(out)
    except json.JSONDecodeError:
        return {"raw_output": out}


def list_agents() -> List[Dict[str, Any]]:
    """Query Herdr for all active agent sessions."""
    res = run_herdr("agent", "list")
    agents = res.get("result", {}).get("agents", [])
    return agents if isinstance(agents, list) else []


def resolve_target(query: str, agents: List[Dict[str, Any]]) -> Optional[Dict[str, Any]]:
    """Match a query string to an agent session by display name, pane ID, or session ID."""
    clean_query = query.strip()
    if not clean_query:
        return None

    # 1. Exact match on display_agent (e.g. 'usps-setup')
    for a in agents:
        if a.get("display_agent") == clean_query:
            return a

    # 2. Exact match on pane_id (e.g. 'w1:p6')
    for a in agents:
        if a.get("pane_id") == clean_query:
            return a

    # 3. Match on shorthand pane ID (e.g. 'p6')
    for a in agents:
        pane = a.get("pane_id", "")
        if pane.endswith(f":{clean_query}") or pane == clean_query:
            return a

    # 4. Exact match on session UUID
    for a in agents:
        session_val = a.get("agent_session", {}).get("value")
        if session_val and session_val.lower() == clean_query.lower():
            return a

    # 5. Case-insensitive substring match on display_agent or terminal title
    lower_query = clean_query.lower()
    matches = []
    for a in agents:
        display = (a.get("display_agent") or "").lower()
        title = (a.get("terminal_title_stripped") or "").lower()
        if lower_query in display or lower_query in title:
            matches.append(a)

    if len(matches) == 1:
        return matches[0]
    elif len(matches) > 1:
        # Check if one of them has exact case-insensitive display match
        for a in matches:
            if (a.get("display_agent") or "").lower() == lower_query:
                return a
        print(f"Ambiguous target '{query}' matches multiple agents:", file=sys.stderr)
        for a in matches:
            print(
                f"  - {a.get('pane_id')}: {a.get('display_agent')} ({a.get('terminal_title_stripped')})",
                file=sys.stderr,
            )
        sys.exit(1)

    return None


def read_pane_output(pane_id: str, lines: int = 60) -> str:
    """Read recent text lines from a Herdr pane."""
    res = run_herdr("pane", "read", pane_id, "--lines", str(lines))
    if "raw_output" in res:
        return res["raw_output"]
    if "result" in res and isinstance(res["result"], dict):
        return res["result"].get("text", "")
    if "error" in res:
        print(f"Warning: Failed to read pane {pane_id}: {res['error']}", file=sys.stderr)
    return ""


def parse_reset_datetime(text: str) -> Optional[datetime.datetime]:
    """Extract and parse scheduled reset datetime from terminal text."""
    now = datetime.datetime.now()

    # Pattern 1: 'try again at Oct 29th, 2026 3:17 AM' or 'Oct 29, 2026 3:17 AM'
    m1 = re.search(
        r"try again at ([A-Za-z]{3})\s+(\d{1,2})(?:st|nd|rd|th)?,?\s+(\d{4})\s+(\d{1,2}:\d{2}\s+[AP]M)",
        text,
        re.IGNORECASE,
    )
    if m1:
        month_str, day_str, year_str, time_str = m1.groups()
        s = f"{month_str} {day_str} {year_str} {time_str}"
        try:
            return datetime.datetime.strptime(s, "%b %d %Y %I:%M %p")
        except ValueError:
            pass

    # Pattern 2: 'resets at 3:17 AM on 29 Oct' or '3:17 AM on 29 Oct 2026'
    m2 = re.search(
        r"resets at (\d{1,2}:\d{2}\s+[AP]M)\s+on\s+(\d{1,2})\s+([A-Za-z]{3})(?:\s+(\d{4}))?",
        text,
        re.IGNORECASE,
    )
    if m2:
        time_str, day_str, month_str, year_str = m2.groups()
        year = int(year_str) if year_str else now.year
        s = f"{month_str} {day_str} {year} {time_str}"
        try:
            return datetime.datetime.strptime(s, "%b %d %Y %I:%M %p")
        except ValueError:
            pass

    # Pattern 3: 'resets at 3:17 AM' without date (today or tomorrow)
    m3 = re.search(r"resets at (\d{1,2}:\d{2}\s+[AP]M)", text, re.IGNORECASE)
    if m3:
        try:
            t = datetime.datetime.strptime(m3.group(1).strip(), "%I:%M %p").time()
            target = datetime.datetime.combine(now.date(), t)
            # If target time is more than 5 minutes in the past today, assume tomorrow
            if target < now - datetime.timedelta(minutes=5):
                target += datetime.timedelta(days=1)
            return target
        except ValueError:
            pass

    return None


def inspect_session(
    pane_id: str, agent_meta: Dict[str, Any]
) -> Dict[str, Any]:
    """Inspect pane output and determine agent limit status, reset time, and credit info."""
    raw_text = read_pane_output(pane_id, lines=60)
    agent_status = agent_meta.get("agent_status", "unknown")

    # 1. Parse 5h limit percentage
    credit_percent = None
    m_credit = re.search(r"5h (?:limit:\s*)?(\d+)% left", raw_text)
    if m_credit:
        credit_percent = int(m_credit.group(1))

    # 2. Parse weekly limit percentage
    weekly_percent = None
    m_weekly = re.search(r"weekly (\d+)% left", raw_text)
    if m_weekly:
        weekly_percent = int(m_weekly.group(1))

    # 3. Detect usage limit hit
    has_limit_notice = bool(
        re.search(r"You’ve hit your usage limit", raw_text, re.IGNORECASE)
        or re.search(r"usage limit reached", raw_text, re.IGNORECASE)
    )
    is_zero_credit = credit_percent == 0

    reset_time = parse_reset_datetime(raw_text)
    now = datetime.datetime.now()

    # Determine if actively limited right now
    is_currently_limited = False
    if is_zero_credit or has_limit_notice:
        if reset_time:
            # If reset time is in the future, it is definitely limited
            if reset_time > now:
                is_currently_limited = True
            else:
                # Reset time passed; if credit_percent is updated > 0, it's restored
                if credit_percent is not None and credit_percent > 0:
                    is_currently_limited = False
                elif agent_status == "working":
                    is_currently_limited = False
                else:
                    # Still showing 0% or limit notice right after reset time
                    is_currently_limited = False
        else:
            if is_zero_credit:
                is_currently_limited = True

    # 4. Check if waiting on human intervention (other than credit limit)
    is_waiting_human = False
    human_reason = ""
    if "The Mac is locked. Please unlock it" in raw_text:
        is_waiting_human = True
        human_reason = "Screen locked / Waiting for unlock"
    elif re.search(r"\[y/N\]", raw_text):
        is_waiting_human = True
        human_reason = "Awaiting interactive prompt confirmation"
    elif "approval required" in raw_text.lower():
        is_waiting_human = True
        human_reason = "Awaiting approval"

    return {
        "pane_id": pane_id,
        "display_name": agent_meta.get("display_agent", "unnamed"),
        "agent_type": agent_meta.get("agent", "unknown"),
        "agent_status": agent_status,
        "credit_percent": credit_percent,
        "weekly_percent": weekly_percent,
        "is_currently_limited": is_currently_limited,
        "has_limit_notice": has_limit_notice,
        "reset_time": reset_time,
        "is_waiting_human": is_waiting_human,
        "human_reason": human_reason,
    }


def send_nudge(pane_id: str, message: str, dry_run: bool = False) -> bool:
    """Send wake-up prompt to the agent pane via Herdr."""
    if dry_run:
        print(f"[DRY-RUN] Would send prompt to {pane_id}: \"{message}\"")
        return True

    res = run_herdr("agent", "prompt", pane_id, message)
    if "result" in res and res["result"].get("type") == "agent_prompted":
        return True

    # Fallback to pane send-text if agent prompt is unavailable or rejected
    err_info = res.get("error", {})
    err_code = err_info.get("code") if isinstance(err_info, dict) else str(err_info)
    print(f"Notice: herdr agent prompt returned ({err_code}); falling back to send-text...", file=sys.stderr)
    fallback = run_herdr("pane", "send-text", pane_id, f"{message}\n")
    return "error" not in fallback


def format_duration(seconds: float) -> str:
    """Format seconds into a human-readable string like '2h 15m 30s'."""
    sec = int(round(seconds))
    if sec < 0:
        sec = 0
    hrs = sec // 3600
    mins = (sec % 3600) // 60
    s = sec % 60
    if hrs > 0:
        return f"{hrs}h {mins:02d}m {s:02d}s"
    if mins > 0:
        return f"{mins}m {s:02d}s"
    return f"{s}s"


def print_status_card(info: Dict[str, Any]) -> None:
    """Display a concise status card for the target agent."""
    name = info["display_name"]
    pane = info["pane_id"]
    agent_type = info["agent_type"]
    status = info["agent_status"].upper()

    credit_str = f"{info['credit_percent']}%" if info["credit_percent"] is not None else "unknown"
    weekly_str = f"{info['weekly_percent']}%" if info["weekly_percent"] is not None else "unknown"

    print(f"Target Agent: {name} (Pane: {pane}, Type: {agent_type})")
    print(f"State:        {status}")
    print(f"5h Credit:    {credit_str} left")
    print(f"Weekly Limit: {weekly_str} left")

    if info["is_currently_limited"]:
        reset_str = info["reset_time"].strftime("%Y-%m-%d %I:%M %p") if info["reset_time"] else "unknown"
        print(f"Limit Status: EXHAUSTED (0% remaining)")
        print(f"Reset Time:   {reset_str}")
    else:
        print(f"Limit Status: OK")

    if info["is_waiting_human"]:
        print(f"Human Blocker: {info['human_reason']}")


def monitor_agent(
    target_query: str,
    message: str,
    interval: int = 60,
    buffer_sec: int = 30,
    check_once: bool = False,
    dry_run: bool = False,
    once: bool = False,
    verbose: bool = False,
) -> None:
    """Main monitoring loop."""
    first_run = True
    was_limited = False

    while True:
        agents = list_agents()
        target = resolve_target(target_query, agents)
        if not target:
            print(f"Error: Target '{target_query}' not found in active Herdr agents.", file=sys.stderr)
            sys.exit(1)

        info = inspect_session(target["pane_id"], target)

        if first_run or verbose:
            print_status_card(info)
            first_run = False
            if check_once:
                return
            print("-" * 50)

        pane_id = info["pane_id"]
        display_name = info["display_name"]
        now = datetime.datetime.now()

        # 1. Check if credit limit is exhausted
        if info["is_currently_limited"]:
            was_limited = True
            reset_dt = info["reset_time"]
            if reset_dt and reset_dt > now:
                remaining_sec = (reset_dt - now).total_seconds()
                sleep_sec = remaining_sec + buffer_sec
                reset_fmt = reset_dt.strftime("%I:%M %p")
                print(
                    f"[{now.strftime('%H:%M:%S')}] {display_name} hit usage limit (0% remaining). "
                    f"Reset scheduled at {reset_fmt} (in {format_duration(remaining_sec)})."
                )
                print(f"Sleeping for {format_duration(sleep_sec)} (until reset + {buffer_sec}s buffer)...")
                try:
                    time.sleep(sleep_sec)
                except KeyboardInterrupt:
                    print("\nMonitoring cancelled by user.")
                    sys.exit(0)

                # Woke up after reset time! Verify credits restored.
                print(f"[{datetime.datetime.now().strftime('%H:%M:%S')}] Reset window passed. Re-checking {display_name}...")
                agents = list_agents()
                target = resolve_target(target_query, agents)
                if not target:
                    print(f"Error: Target '{target_query}' lost after sleep.", file=sys.stderr)
                    sys.exit(1)
                recheck = inspect_session(target["pane_id"], target)

                if not recheck["is_currently_limited"]:
                    print(f"Credits restored (5h credit: {recheck['credit_percent']}% left).")
                    print(f"Sending prompt to {display_name} ({pane_id}): \"{message}\"")
                    success = send_nudge(pane_id, message, dry_run=dry_run)
                    if success:
                        print(f"Successfully nudged {display_name} to continue!")
                    else:
                        print(f"Failed to deliver prompt to {display_name}.", file=sys.stderr)

                    was_limited = False
                    if once:
                        print("Nudge complete (--once). Exiting.")
                        return
                    print(f"Resuming monitor for {display_name} (checking every {interval}s)...")
                else:
                    print(f"Warning: {display_name} still reports limited. Waiting another {interval}s...")
            else:
                print(
                    f"[{now.strftime('%H:%M:%S')}] {display_name} shows 0% credits. Checking again in {interval}s..."
                )

        # 2. Check if agent was previously limited and is now ready/restored
        elif was_limited and not info["is_currently_limited"]:
            print(f"[{now.strftime('%H:%M:%S')}] Credits have restored! Nudging {display_name}...")
            send_nudge(pane_id, message, dry_run=dry_run)
            was_limited = False
            if once:
                print("Nudge complete (--once). Exiting.")
                return
            print(f"Resuming monitor for {display_name} (checking every {interval}s)...")

        # 3. Agent is active/working or idle with healthy credits
        else:
            status_desc = info["agent_status"]
            credit_desc = f"{info['credit_percent']}%" if info["credit_percent"] is not None else "healthy"
            if verbose:
                print(
                    f"[{now.strftime('%H:%M:%S')}] {display_name} is {status_desc} (credits: {credit_desc}). Monitoring..."
                )

        try:
            time.sleep(interval)
        except KeyboardInterrupt:
            print("\nMonitoring stopped.")
            sys.exit(0)


def main() -> None:
    parser = argparse.ArgumentParser(
        prog="agent-nudge",
        description="Monitor a Herdr coding agent session and automatically wake it up when credits reset.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""Examples:
  agent-nudge usps-setup
  agent-nudge usps-setup --check-once
  agent-nudge usps-setup --message "Credits restored! Resume implementation."
  agent-nudge --list
""",
    )

    parser.add_argument(
        "target",
        nargs="?",
        help="Agent name, pane ID, or session UUID (e.g. 'usps-setup' or 'w1:p6').",
    )
    parser.add_argument(
        "--check-once",
        "-1",
        action="store_true",
        help="Inspect session status once and exit immediately without monitoring.",
    )
    parser.add_argument(
        "--once",
        action="store_true",
        help="Exit after sending the first successful wake-up prompt (default is to keep monitoring continuously).",
    )
    parser.add_argument(
        "--message",
        "-m",
        default="Usage limit reset. Please continue.",
        help="Prompt text to send when waking up the agent (default: 'Usage limit reset. Please continue.').",
    )
    parser.add_argument(
        "--interval",
        "-i",
        type=int,
        default=60,
        help="Polling interval in seconds while monitoring (default: 60s).",
    )
    parser.add_argument(
        "--buffer",
        "-b",
        type=int,
        default=30,
        help="Buffer seconds to wait after scheduled reset time before sending prompt (default: 30s).",
    )
    parser.add_argument(
        "--loop",
        "-l",
        action="store_true",
        help=argparse.SUPPRESS,  # Deprecated alias: looping is now the default
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Show what prompt would be sent without actually modifying session state.",
    )
    parser.add_argument(
        "--verbose",
        "-v",
        action="store_true",
        help="Print status on every polling check.",
    )
    parser.add_argument(
        "--list",
        action="store_true",
        help="List all active agents in Herdr and exit.",
    )

    args = parser.parse_args()

    if args.list or not args.target:
        agents = list_agents()
        if not agents:
            print("No active agents found in Herdr.")
            sys.exit(0)
        print(f"Active Herdr Agents ({len(agents)}):")
        print(f"{'Pane':<8} {'Display Name':<28} {'Agent':<8} {'Status':<10} {'Title'}")
        print("-" * 75)
        for a in agents:
            pane = a.get("pane_id", "")
            disp = a.get("display_agent") or "-"
            agent_type = a.get("agent", "")
            status = a.get("agent_status", "")
            title = a.get("terminal_title_stripped") or ""
            print(f"{pane:<8} {disp:<28} {agent_type:<8} {status:<10} {title}")

        if not args.target:
            print("\nSpecify a target agent to monitor: agent-nudge <target>")
            sys.exit(0)
        sys.exit(0)

    monitor_agent(
        target_query=args.target,
        message=args.message,
        interval=args.interval,
        buffer_sec=args.buffer,
        check_once=args.check_once,
        dry_run=args.dry_run,
        once=args.once,
        verbose=args.verbose,
    )


if __name__ == "__main__":
    main()
