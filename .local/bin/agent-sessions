#!/usr/bin/env python3
"""Emit shell-ready `<short-agent> <session-name>` commands for known agent sessions."""
from importlib.machinery import SourceFileLoader
import importlib.util
from pathlib import Path
import shlex
import sys


SCRIPT_PATH = Path.home() / '.local/bin/named-session.py'
loader = SourceFileLoader('named_session', str(SCRIPT_PATH))
spec = importlib.util.spec_from_loader('named_session', loader)
named_session = importlib.util.module_from_spec(spec)
spec.loader.exec_module(named_session)

AGENTS = (
    ('cplt', named_session.CopilotAdapter),
    ('agy', named_session.AntigravityAdapter),
    ('cdx', named_session.CodexAdapter),
)


def format_arg(name):
    cleaned = ' '.join(name.splitlines()).strip()
    return shlex.quote(cleaned)


def collect_commands():
    commands = []
    for short_cmd, adapter in AGENTS:
        try:
            names = adapter.native_names()
        except Exception:
            continue
        seen = set()
        # Preserve reverse-chronological/recent discovery order where possible by iterating reversed
        for title in reversed(list(names.values())):
            if not isinstance(title, str):
                continue
            cleaned = ' '.join(title.splitlines()).strip()
            if not cleaned or cleaned.startswith('-') or cleaned in seen:
                continue
            seen.add(cleaned)
            commands.append(f'{short_cmd} {format_arg(cleaned)}')
    return commands


def main():
    for cmd in collect_commands():
        print(cmd)


if __name__ == '__main__':
    sys.exit(main())
