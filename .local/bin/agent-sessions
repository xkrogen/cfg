#!/usr/bin/env python3
"""Emit shell-ready `<short-agent> <session-name>` commands for known agent sessions."""
import importlib.util
from pathlib import Path
import shlex
import sys


AGENTS = (
    ('cplt', 'copilot_named_sessions', Path.home() / '.copilot/bin/named-session.py'),
    ('agy', 'agy_named_sessions', Path.home() / '.gemini/antigravity-cli/bin/named-session.py'),
    ('cdx', 'codex_named_sessions', Path.home() / '.codex/bin/named-session.py'),
)


def load_module(module_name, script_path):
    if not script_path.is_file():
        return None
    spec = importlib.util.spec_from_file_location(module_name, script_path)
    if spec is None or spec.loader is None:
        return None
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def format_arg(name):
    cleaned = ' '.join(name.splitlines()).strip()
    return shlex.quote(cleaned)


def collect_commands():
    commands = []
    for short_cmd, module_name, script_path in AGENTS:
        try:
            module = load_module(module_name, script_path)
            if module is None:
                continue
            names = module.native_names()
        except Exception:
            continue
        seen = set()
        # Preserve reverse-chronological/recent discovery order where possible by iterating reversed
        for title in reversed(list(names.values())):
            if not isinstance(title, str):
                continue
            cleaned = ' '.join(title.splitlines()).strip()
            if not cleaned or cleaned.startswith('-') or cleaned in seen:
                continue
            seen.add(cleaned)
            commands.append(f'{short_cmd} {format_arg(cleaned)}')
    return commands


def main():
    for cmd in collect_commands():
        print(cmd)


if __name__ == '__main__':
    sys.exit(main())
