Include ~/.ssh/config.watchtower*
Host azurevm
    HostName ekrogen-ld2.linkedin.biz
    ForwardAgent yes
    GSSAPIAuthentication yes
    GSSAPIDelegateCredentials yes
    CheckHostIp yes
    StrictHostKeyChecking yes
    ControlMaster auto
    ControlPath ~/.ssh/master-LI-%C
    ControlPersist 12h
    ServerAliveInterval 30
    ServerAliveCountMax 3

Match host github.com user git
    IdentityFile ~/.ssh/personal_github_xkrogen
    IdentitiesOnly yes
    IdentityAgent none

# Herdr Mirror owns a dedicated control socket for its daemon/API traffic.
# Pane streams and ordinary RDev SSH commands share this separate host master.
Host dpp-test-infra/* dpp-test-infra_*
    ControlMaster auto
    ControlPath ~/.ssh/herdr-rdev-%C
    ControlPersist 12h
    ServerAliveInterval 15
    ServerAliveCountMax 3
